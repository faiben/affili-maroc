# Base de données - SQLite pour le développement
DATABASE_URL="file:./dev.db"

# Secret pour NextAuth.js (générer un token aléatoire)
AUTH_SECRET="votre-secret-tres-long-et-aleatoire"

# URL publique de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Docker ---
# En conteneur, la base SQLite est stockée dans /app/data
# DATABASE_URL="file:/app/data/dev.db"
# NEXT_PUBLIC_APP_URL="http://localhost:4000"

# Pour la production avec PostgreSQL (Supabase/Neon/Vercel Postgres)
# DATABASE_URL="postgresql://user:password@host:5432/affilimaroc"

# Configuration SMTP pour l'envoi des emails de vérification
# Si non configuré, l'application fonctionne en mode démo avec un lien affiché.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="password"
SMTP_FROM="noreply@affilimaroc.ma"
# Utiliser "true" pour le port 465 (SSL), généralement "false" pour 587 (STARTTLS)
SMTP_SECURE="false"
