# Base de données - PostgreSQL (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/affilimaroc?sslmode=require"

# Secret pour NextAuth.js (générer un token aléatoire long)
AUTH_SECRET="votre-secret-tres-long-et-aleatoire"

# URL publique de l'application (sur Netlify: votre URL de site)
NEXT_PUBLIC_APP_URL="https://votre-site.netlify.app"

# --- Docker (optionnel) ---
# En conteneur, la base PostgreSQL est fournie par l'hébergeur.
# DATABASE_URL="postgresql://user:password@host:5432/affilimaroc?sslmode=require"
# NEXT_PUBLIC_APP_URL="http://localhost:4000"

# Configuration SMTP pour l'envoi des emails de vérification
# Si non configuré, l'application fonctionne en mode démo avec un lien affiché.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="password"
SMTP_FROM="noreply@affilimaroc.ma"
# Utiliser "true" pour le port 465 (SSL), généralement "false" pour 587 (STARTTLS)
SMTP_SECURE="false"
