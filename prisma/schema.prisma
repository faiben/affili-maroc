generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  phone         String?
  phoneVerified Boolean  @default(false)
  cin           String?
  password      String
  name          String
  image         String?
  role          String   // ENTERPRISE | AFFILIATE | ADMIN
  status        String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts               Account[]
  sessions               Session[]
  enterprise             EnterpriseProfile?
  affiliate              AffiliateProfile?
  products               Product[]
  affiliateLinks         AffiliateLink[]
  conversions            Conversion[]
  commissions            Commission[]
  withdrawals            Withdrawal[]
  applicationsSent       AffiliateApplication[] @relation("AffiliateApplications")
  applicationsReceived   AffiliateApplication[] @relation("EnterpriseApplications")
  disputesOpened         Dispute[] @relation("DisputeOpener")
  disputesAgainst        Dispute[] @relation("DisputeTarget")
  enterpriseRules        EnterpriseRule[]
  ruleAgreements         RuleAgreement[]
  marketingMaterials     MarketingMaterial[]

  @@map("users")
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EnterpriseProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  description String?
  website     String?
  address     String?
  city        String?
  ice         String?
  rc          String?
  balance     Float   @default(0)
  platformFee Float   @default(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("enterprise_profiles")
}

model AffiliateProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  bio           String?
  website       String?
  socialYoutube String?
  socialInsta   String?
  socialTiktok  String?
  socialX       String?
  balance       Float   @default(0)
  totalEarned   Float   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affiliate_profiles")
}

model Product {
  id              String   @id @default(cuid())
  enterpriseId    String
  name            String
  description     String?
  price           Float
  imageUrl        String?
  url             String
  category        String
  commissionType  String   // PERCENTAGE | FIXED
  commissionValue Float
  commissionMin   Float    @default(0)
  commissionMax   Float    @default(0)
  cookieDays      Int      @default(30)
  isActive        Boolean  @default(true)
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enterprise     User          @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  affiliateLinks AffiliateLink[]
  conversions    Conversion[]

  @@map("products")
}

model AffiliateLink {
  id          String   @id @default(cuid())
  productId   String
  affiliateId String
  code        String   @unique
  createdAt   DateTime @default(now())
  isActive    Boolean  @default(true)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliate   User         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  clicks      Click[]
  conversions Conversion[]

  @@unique([productId, affiliateId])
  @@map("affiliate_links")
}

model Click {
  id              String   @id @default(cuid())
  affiliateLinkId String
  ip              String?
  userAgent       String?
  referrer        String?
  country         String?
  createdAt       DateTime @default(now())

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  @@map("clicks")
}

model Conversion {
  id              String   @id @default(cuid())
  affiliateLinkId String
  productId       String
  affiliateId     String
  amount          Float
  commission      Float
  status          String   @default("PENDING") // PENDING | VALIDATED | REJECTED
  validatedAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  affiliateLink    AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliate        User          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  commissionRecord Commission?

  @@map("conversions")
}

model Commission {
  id           String   @id @default(cuid())
  conversionId String   @unique
  affiliateId  String
  enterpriseId String
  amount       Float
  platformFee  Float
  netAmount    Float
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  conversion Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  affiliate  User       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("commissions")
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  method      String   // BANK_AL_MAGHRIB | CIH | ATTIJARIWAFA | CASH_PLUS | WAFACASH | INWI_MONEY | ORANGE_MONEY
  accountInfo String
  status      String   @default("PENDING") // PENDING | PROCESSING | PAID | REJECTED
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model AffiliateApplication {
  id           String   @id @default(cuid())
  enterpriseId String
  affiliateId  String
  productId    String?
  message      String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enterprise User @relation("EnterpriseApplications", fields: [enterpriseId], references: [id], onDelete: Cascade)
  affiliate  User @relation("AffiliateApplications", fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_applications")
}

model Dispute {
  id           String   @id @default(cuid())
  openerId     String
  targetId     String
  conversionId String?
  reason       String
  status       String   @default("OPEN") // OPEN | RESOLVED | CLOSED
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  opener User @relation("DisputeOpener", fields: [openerId], references: [id], onDelete: Cascade)
  target User @relation("DisputeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@map("disputes")
}

model PlatformSettings {
  id              String  @id @default("settings")
  platformFee     Float   @default(10)
  minWithdrawal   Float   @default(100)
  cookieDays      Int     @default(30)
  payoutDelayDays Int     @default(14)
  autoValidate    Boolean @default(false)

  @@map("platform_settings")
}

model EnterpriseRule {
  id           String   @id @default(cuid())
  enterpriseId String
  title        String
  content      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enterprise User            @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  agreements RuleAgreement[]

  @@index([enterpriseId])
  @@map("enterprise_rules")
}

model RuleAgreement {
  id          String   @id @default(cuid())
  ruleId      String
  affiliateId String
  agreedAt    DateTime @default(now())

  rule      EnterpriseRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  affiliate User           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([ruleId, affiliateId])
  @@map("rule_agreements")
}

model MarketingMaterial {
  id           String   @id @default(cuid())
  enterpriseId String
  title        String
  type         String // BANNER | IMAGE | TEXT
  description  String?
  imageUrl     String?
  content      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enterprise User @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@index([enterpriseId])
  @@map("marketing_materials")
}
